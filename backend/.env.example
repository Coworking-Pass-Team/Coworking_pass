# PostgreSQL connection string (Neon in production, a local instance in development)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Secret used to sign login tokens (JWT, 24h). Use a long random value.
JWT_SECRET="change-me"

# Resend API key for verification, password-reset and notification emails.
# Optional in local development: without it the one-time codes are printed in the server console instead.
RESEND_API_KEY=""
# Sender shown on every email. Must be on a domain verified in Resend; defaults to Resend's test sender
# (onboarding@resend.dev), which only delivers to the Resend account owner.
RESEND_FROM_EMAIL=""
# Public address of the site, used for links inside emails
NEXT_PUBLIC_SITE_URL=""
# QA/local only: also accept the shared test code 123456 as a one-time code. Leave unset (or false) in production.
ALLOW_MASTER_OTP=""

# Super Admin provisioning (no credentials are hard-coded). Set both to create the account on first start;
# an existing account keeps its password unless SUPER_ADMIN_RESET_PASSWORD=true.
SUPER_ADMIN_EMAIL=""
SUPER_ADMIN_PASSWORD=""
# Local development only: seeds admin@coworkingpass.sa / password. Ignored when NODE_ENV=production.
DEV_SEED_ADMIN=""
