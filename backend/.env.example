# PostgreSQL connection string (Neon in production, a local instance in development)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Secret used to sign login tokens (JWT, 24h). Use a long random value.
JWT_SECRET="change-me"

# Resend API key for verification and notification emails (optional in local development)
RESEND_API_KEY=""
